# Snow Forms Environment Configuration
# Copy this file to .env and configure with your credentials

# Database (Turso / libSQL)
# Primary: libsql://au-forms-samyak2501.aws-ap-south-1.turso.io
TURSO_DATABASE_URL="libsql://au-forms-samyak2501.aws-ap-south-1.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="generate_with_openssl_rand_hex_32"
BETTER_AUTH_URL="http://localhost:4000"

# Server & Client URLs
PORT=4000
FRONTEND_URL="http://localhost:5173"

# Email / SMTP Configuration (Gmail SMTP for avantika.edu.in)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="samyak.jain1@avantika.edu.in"
# Gmail App Password (16 characters, spaces stripped)
SMTP_PASSWORD="your_gmail_app_password"
EMAIL_FROM="Snow Forms <samyak.jain1@avantika.edu.in>"
COLLEGE_EMAIL_DOMAIN="avantika.edu.in"

# Storage & Upload limits
MAX_FILE_SIZE_MB=10
